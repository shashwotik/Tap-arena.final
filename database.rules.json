{
  "rules": {
    "matchmakingQueue": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('uid').val() === $uid"
      }
    },

    "playerMatchAssignment": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },

    "matches": {
      "$matchId": {
        ".read": "auth != null && (data.child('player1/uid').val() === auth.uid || data.child('player2/uid').val() === auth.uid)",
        ".write": "auth != null && (data.child('player1/uid').val() === auth.uid || data.child('player2/uid').val() === auth.uid || newData.child('player1/uid').val() === auth.uid || newData.child('player2/uid').val() === auth.uid)"
      }
    }
  }
}
